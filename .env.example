# Адреса локальної бази SQLite
DATABASE_URL=
# Порт HTTP-сервера
PORT=
# Швидкий демонстраційний вхід
DEMO_MODE=
# Захищені cookie для HTTPS
COOKIE_SECURE=
# Випадковий пароль створює npm run setup
DEMO_PASSWORD=
# Додаткові дозволені Host із портом, через кому
ALLOWED_HOSTS=
# Необов’язковий каталог файлів
STORAGE_ROOT=
